# ============================================================================
#  Frisca OS — .gitignore
#  Excludes build artifacts, editor files, and OS-specific junk.
# ============================================================================

# ── Build artifacts ──────────────────────────────────────────────────────────
build/
*.o
*.bin
*.elf
*.iso
*.img
*.map
*.d

# ── Kernel output ────────────────────────────────────────────────────────────
kernel.bin
bootloader.bin
frisca-os.bin
frisca-os.iso

# ── QEMU / emulator files ────────────────────────────────────────────────────
*.qcow2
*.vmdk
*.vdi
*.log
qemu.log
serial.log
screendump*.ppm
screendump*.png

# ── Debugging ────────────────────────────────────────────────────────────────
*.sym
*.lst
*.dis
gdb.txt
core
core.*

# ── Editor / IDE ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.*.swp
.clangd/
compile_commands.json
tags
cscope.out

# ── OS-specific ──────────────────────────────────────────────────────────────
# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ── Compiler / toolchain ─────────────────────────────────────────────────────
*.gch
*.pch
*.su
*.idb
*.pdb

# ── Backup files ─────────────────────────────────────────────────────────────
*.bak
*.orig
*.rej
*.old

# ── Temporary files ──────────────────────────────────────────────────────────
*.tmp
*.temp
tmp/
temp/